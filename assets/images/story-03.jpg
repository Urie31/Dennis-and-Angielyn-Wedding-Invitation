<svg xmlns="http://www.w3.org/2000/svg" width="800" height="600" viewBox="0 0 800 600">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#3a5018"/>
      <stop offset="50%" style="stop-color:#4a3a10"/>
      <stop offset="100%" style="stop-color:#1e1808"/>
    </linearGradient>
  </defs>
  <rect width="800" height="600" fill="url(#bg)"/>
  <circle cx="200" cy="150" r="160" fill="rgba(201,168,76,0.07)"/>
  <circle cx="700" cy="500" r="180" fill="rgba(201,168,76,0.06)"/>
  <!-- Walking couple silhouette -->
  <ellipse cx="360" cy="240" rx="36" ry="46" fill="rgba(201,168,76,0.2)"/>
  <rect x="330" y="283" width="56" height="110" rx="6" fill="rgba(201,168,76,0.16)"/>
  <ellipse cx="450" cy="235" rx="32" ry="42" fill="rgba(201,168,76,0.18)"/>
  <rect x="422" y="274" width="52" height="115" rx="6" fill="rgba(201,168,76,0.14)"/>
  <!-- Joined hands -->
  <rect x="382" y="330" width="42" height="14" rx="7" fill="rgba(201,168,76,0.22)"/>
  <!-- Path -->
  <ellipse cx="400" cy="520" rx="300" ry="30" fill="rgba(201,168,76,0.08)"/>
  <text x="400" y="490" font-family="Georgia,serif" font-size="18" fill="rgba(201,168,76,0.45)" text-anchor="middle" letter-spacing="4">BUILDING OUR WORLD</text>
  <text x="400" y="518" font-family="Arial,sans-serif" font-size="11" fill="rgba(201,168,76,0.25)" text-anchor="middle">story-03.jpg</text>
</svg>
