<svg xmlns="http://www.w3.org/2000/svg" width="800" height="1000" viewBox="0 0 800 1000">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#5a3e12"/>
      <stop offset="100%" style="stop-color:#2a1e06"/>
    </linearGradient>
  </defs>
  <rect width="800" height="1000" fill="url(#bg)"/>
  <circle cx="400" cy="380" r="280" fill="rgba(201,168,76,0.07)"/>
  <!-- Silhouette couple -->
  <ellipse cx="340" cy="320" rx="55" ry="70" fill="rgba(201,168,76,0.15)"/>
  <rect x="300" y="385" width="80" height="130" rx="8" fill="rgba(201,168,76,0.12)"/>
  <ellipse cx="460" cy="310" rx="48" ry="62" fill="rgba(201,168,76,0.13)"/>
  <rect x="422" y="368" width="72" height="140" rx="8" fill="rgba(201,168,76,0.1)"/>
  <text x="400" y="600" font-family="Georgia,serif" font-size="20" fill="rgba(201,168,76,0.4)" text-anchor="middle" letter-spacing="4">COUPLE PHOTO</text>
  <text x="400" y="630" font-family="Arial,sans-serif" font-size="12" fill="rgba(201,168,76,0.25)" text-anchor="middle">couple-01.jpg</text>
</svg>
