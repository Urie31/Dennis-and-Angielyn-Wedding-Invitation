<svg xmlns="http://www.w3.org/2000/svg" width="1600" height="700" viewBox="0 0 1600 700">
  <defs>
    <linearGradient id="sky" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#3d2e0e"/>
      <stop offset="100%" style="stop-color:#6b4f1a"/>
    </linearGradient>
  </defs>
  <rect width="1600" height="700" fill="url(#sky)"/>
  <!-- Ground -->
  <rect x="0" y="500" width="1600" height="200" fill="rgba(30,20,5,0.5)"/>
  <!-- Church silhouette -->
  <rect x="600" y="200" width="400" height="320" fill="rgba(201,168,76,0.12)"/>
  <polygon points="800,80 560,200 1040,200" fill="rgba(201,168,76,0.15)"/>
  <rect x="740" y="350" width="120" height="170" fill="rgba(201,168,76,0.1)"/>
  <!-- Cross -->
  <rect x="792" y="100" width="16" height="60" fill="rgba(201,168,76,0.3)"/>
  <rect x="776" y="120" width="48" height="12" fill="rgba(201,168,76,0.3)"/>
  <!-- Trees -->
  <ellipse cx="480" cy="380" rx="80" ry="120" fill="rgba(40,60,20,0.4)"/>
  <ellipse cx="1120" cy="380" rx="80" ry="120" fill="rgba(40,60,20,0.4)"/>
  <ellipse cx="350" cy="420" rx="60" ry="90" fill="rgba(40,60,20,0.35)"/>
  <ellipse cx="1250" cy="420" rx="60" ry="90" fill="rgba(40,60,20,0.35)"/>
  <text x="800" y="620" font-family="Georgia,serif" font-size="24" fill="rgba(201,168,76,0.45)" text-anchor="middle" letter-spacing="5">VENUE PHOTO</text>
  <text x="800" y="655" font-family="Arial,sans-serif" font-size="13" fill="rgba(201,168,76,0.25)" text-anchor="middle">venue.jpg</text>
</svg>
