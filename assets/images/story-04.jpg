<svg xmlns="http://www.w3.org/2000/svg" width="800" height="600" viewBox="0 0 800 600">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#0e0c06"/>
      <stop offset="100%" style="stop-color:#2a1e08"/>
    </linearGradient>
  </defs>
  <rect width="800" height="600" fill="url(#bg)"/>
  <!-- Stars -->
  <circle cx="100" cy="60" r="2" fill="rgba(201,168,76,0.6)"/>
  <circle cx="250" cy="40" r="1.5" fill="rgba(201,168,76,0.5)"/>
  <circle cx="500" cy="30" r="2" fill="rgba(201,168,76,0.55)"/>
  <circle cx="680" cy="55" r="1.5" fill="rgba(201,168,76,0.5)"/>
  <circle cx="750" cy="90" r="2" fill="rgba(201,168,76,0.45)"/>
  <circle cx="350" cy="70" r="1" fill="rgba(201,168,76,0.4)"/>
  <circle cx="600" cy="80" r="1.5" fill="rgba(201,168,76,0.5)"/>
  <!-- Warm glow on ground -->
  <ellipse cx="400" cy="500" rx="250" ry="60" fill="rgba(201,168,76,0.08)"/>
  <!-- Kneeling figure -->
  <ellipse cx="380" cy="310" rx="30" ry="38" fill="rgba(201,168,76,0.2)"/>
  <rect x="355" y="345" width="50" height="60" rx="5" fill="rgba(201,168,76,0.16)"/>
  <rect x="355" y="400" width="22" height="50" rx="4" fill="rgba(201,168,76,0.14)"/>
  <!-- Standing figure -->
  <ellipse cx="470" cy="280" rx="32" ry="42" fill="rgba(201,168,76,0.18)"/>
  <rect x="444" y="318" width="52" height="120" rx="6" fill="rgba(201,168,76,0.14)"/>
  <!-- Ring sparkle -->
  <circle cx="360" cy="370" r="8" fill="rgba(255,220,100,0.5)"/>
  <line x1="360" y1="355" x2="360" y2="348" stroke="rgba(255,220,100,0.6)" stroke-width="1.5"/>
  <line x1="360" y1="385" x2="360" y2="392" stroke="rgba(255,220,100,0.6)" stroke-width="1.5"/>
  <line x1="345" y1="370" x2="338" y2="370" stroke="rgba(255,220,100,0.6)" stroke-width="1.5"/>
  <line x1="375" y1="370" x2="382" y2="370" stroke="rgba(255,220,100,0.6)" stroke-width="1.5"/>
  <text x="400" y="510" font-family="Georgia,serif" font-size="18" fill="rgba(201,168,76,0.45)" text-anchor="middle" letter-spacing="4">THE PROPOSAL</text>
  <text x="400" y="538" font-family="Arial,sans-serif" font-size="11" fill="rgba(201,168,76,0.25)" text-anchor="middle">story-04.jpg</text>
</svg>
