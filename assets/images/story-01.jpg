<svg xmlns="http://www.w3.org/2000/svg" width="800" height="600" viewBox="0 0 800 600">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#4a6020"/>
      <stop offset="60%" style="stop-color:#3d4e18"/>
      <stop offset="100%" style="stop-color:#1e2a08"/>
    </linearGradient>
  </defs>
  <rect width="800" height="600" fill="url(#bg)"/>
  <!-- Sunlight rays -->
  <circle cx="650" cy="80" r="120" fill="rgba(201,168,76,0.12)"/>
  <circle cx="650" cy="80" r="60" fill="rgba(201,168,76,0.1)"/>
  <!-- Ground -->
  <ellipse cx="400" cy="580" rx="500" ry="80" fill="rgba(30,40,10,0.5)"/>
  <!-- Couple silhouette outdoors -->
  <ellipse cx="340" cy="280" rx="38" ry="48" fill="rgba(201,168,76,0.2)"/>
  <rect x="310" y="325" width="58" height="100" rx="6" fill="rgba(201,168,76,0.16)"/>
  <ellipse cx="440" cy="275" rx="34" ry="44" fill="rgba(201,168,76,0.18)"/>
  <rect x="412" y="316" width="54" height="105" rx="6" fill="rgba(201,168,76,0.14)"/>
  <!-- Trees -->
  <ellipse cx="100" cy="300" rx="70" ry="200" fill="rgba(30,50,10,0.5)"/>
  <ellipse cx="700" cy="280" rx="80" ry="220" fill="rgba(30,50,10,0.45)"/>
  <text x="400" y="490" font-family="Georgia,serif" font-size="18" fill="rgba(201,168,76,0.45)" text-anchor="middle" letter-spacing="4">HOW WE MET</text>
  <text x="400" y="518" font-family="Arial,sans-serif" font-size="11" fill="rgba(201,168,76,0.25)" text-anchor="middle">story-01.jpg</text>
</svg>
